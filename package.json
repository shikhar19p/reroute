{
  "name": "reroute",
  "version": "1.0.0",
  "main": "index.ts",
  "expo": {
    "autolinking": {
      "android": {
        "exclude": ["expo-firebase-core"]
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "node scripts/switch-android-env.js && expo run:android",
    "android:release": "node scripts/ensure-google-services.js && cd android && .\\gradlew.bat assembleRelease",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:prod": "expo export --platform web --output-dir dist && node scripts/post-build-web.js",
    "web:minify": "EXPO_WEB_MINIFY=true expo start --web",
    "web:highmem": "set NODE_OPTIONS=--max-old-space-size=8192&& expo start --web -c",
    "start:staging": "dotenv -e .env.staging -- expo start",
    "web:staging": "dotenv -e .env.staging -- expo start --web",
    "android:staging": "dotenv -e .env.staging -- node scripts/switch-android-env.js && dotenv -e .env.staging -- expo run:android",
    "web:staging:highmem": "dotenv -e .env.staging -v NODE_OPTIONS=--max-old-space-size=8192 -- expo start --web -c",
    "use:staging": "firebase use staging",
    "use:prod": "firebase use production",
    "deploy:staging": "firebase use staging && firebase deploy --only functions,firestore:rules,firestore:indexes,storage --project reroute-aventures-dev",
    "deploy:prod": "firebase use production && firebase deploy --only functions,firestore:rules,firestore:indexes,storage --project rustique-6b7c4",
    "ensure-firebase": "node scripts/ensure-google-services.js",
    "postinstall": "patch-package",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-google-signin/google-signin": "^11.0.1",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.26",
    "@sentry/react-native": "~7.2.0",
    "expo": "~54.0.21",
    "expo-auth-session": "~7.0.8",
    "expo-blur": "~15.0.7",
    "expo-constants": "^18.0.9",
    "expo-document-picker": "^14.0.7",
    "expo-firebase-recaptcha": "^2.3.1",
    "expo-font": "^14.0.9",
    "expo-haptics": "^15.0.7",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "^14.0.7",
    "expo-image-picker": "^17.0.8",
    "expo-linear-gradient": "~15.0.7",
    "expo-location": "~19.0.8",
    "expo-notifications": "^0.32.12",
    "expo-splash-screen": "~31.0.11",
    "expo-status-bar": "~3.0.8",
    "expo-web-browser": "~15.0.8",
    "firebase": "^12.3.0",
    "lucide-react-native": "^0.544.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1313.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-razorpay": "^2.3.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.1.3",
    "@react-native/metro-config": "latest",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "dotenv-cli": "^11.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.0",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2"
  },
  "private": true,
  "overrides": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "react-test-renderer": "19.1.0"
  }
}
